// Supplements ExpandedActionScript.schclass for validation use.
//
// The vendored base file is the BigFix console's display grammar and is tuned
// for highlighting, not validation: its `url` lexClass only matches `http:`,
// and the console's per-operator generator drops `surrender device id` (see
// jgstew/pre-commit-bigfix#3). Corrections belong HERE, never in the vendored
// base file, which must stay byte-exact with the console's output.

// The base url class does not end at '}', so an unquoted URL inside a {...}
// substitution would swallow the closing brace and falsely leave the
// substitution unterminated; add '}' to the end separators for both schemes.
lexClass:
	name		= url
	end:separators	= ' ', '\t', '*', '"', '}', @eol

lexClass:
	name		= url_https
	parent:dyn	= global
	previous:tag	= @specs, ' ', '\t', @eol
	start:Tag	= 'https:'
	end:separators	= ' ', '\t', '*', '"', '}', @eol
	txt:colorBK	= 0xC0FFC0
	txt:Underline	= 1
	DisplayName	= 'URL (https)'

lexClass:
	name		= keywords
	token:tag	= 'surrender device id'

// `override wait` / `override run` blocks are followed by keyword=value
// option lines (e.g. `completion=job`) that the console's display grammar
// leaves uncolored, so the linter saw them as unknown verbs (E300). Matching
// requires `=` as the token end separator (keywords default to whitespace),
// which also keeps a bare `hidden` line from matching. The grammar is lexical
// and cannot scope these to override blocks; anywhere at line start is
// accepted. Option names per
// https://developer.bigfix.com/action-script/reference/execution/override.html
// (may not be exhaustive).
lexClass:
	name		= override_options
	parent		= global
	previous:tag	= @eol
	token:end:separators = '='
	token:tag	= 'completion'
	token:tag	= 'priority'
	token:tag	= 'hidden'
	token:tag	= 'detached'
	token:tag	= 'runas'
	token:tag	= 'user'
	token:tag	= 'password'
	token:tag	= 'asadmin'
	token:tag	= 'targetuser'
	token:tag	= 'timeout_seconds'
	token:tag	= 'disposition'
	DisplayName	= 'Override option (keyword=value)'
